FROM node:22-slim

# Instalar dependencias del sistema incluyendo Chromium y herramientas necesarias
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    chromium \
    unzip \
    fonts-liberation \
    libappindicator3-1 \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdbus-1-3 \
    libgdk-pixbuf2.0-0 \
    libnspr4 \
    libnss3 \
    libx11-xcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    xdg-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/server

# Variables de entorno para Puppeteer
ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

COPY server/package*.json ./

# Instalar dependencias (incluyendo puppeteer-core)
RUN npm ci

COPY server/ .

EXPOSE 3000

CMD ["node", "app.js"]